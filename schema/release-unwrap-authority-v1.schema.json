{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover-community.github.io/lean-eval/schemas/release-unwrap-authority-v1.schema.json",
  "title": "Lean Eval disclosure-safe release unwrap authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "release_commit",
    "state_commit",
    "started_event_id",
    "archive_repository",
    "archive_commit",
    "archive_path",
    "archive_ciphertext_sha256",
    "eligible_at",
    "plan_sha256",
    "started_event_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["production", "staging"] },
    "release_commit": { "$ref": "#/$defs/commit" },
    "state_commit": { "$ref": "#/$defs/commit" },
    "started_event_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid7" },
        { "const": "" }
      ]
    },
    "archive_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "archive_commit": { "$ref": "#/$defs/commit" },
    "archive_path": {
      "type": "string",
      "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
    },
    "archive_ciphertext_sha256": { "$ref": "#/$defs/digest" },
    "eligible_at": { "$ref": "#/$defs/timestamp" },
    "plan_sha256": { "$ref": "#/$defs/digest" },
    "started_event_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "const": "" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "environment": { "const": "production" } } },
      "then": {
        "properties": {
          "started_event_id": { "$ref": "#/$defs/uuid7" },
          "started_event_sha256": { "$ref": "#/$defs/digest" }
        }
      },
      "else": {
        "properties": {
          "started_event_id": { "const": "" },
          "started_event_sha256": { "const": "" }
        }
      }
    }
  ],
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
