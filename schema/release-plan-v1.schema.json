{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/release-plan-v1.schema.json",
  "title": "LeanEval release preparation plan schema version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "empty" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "next_release_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "not_due" },
        "next_release_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "started_transition", "request"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "execution" },
        "started_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_type", "subject_id", "causation_event_id", "payload"],
          "properties": {
            "event_type": { "const": "release.started" },
            "subject_id": { "$ref": "#/$defs/result" },
            "causation_event_id": { "$ref": "#/$defs/uuid7" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt"],
              "properties": {
                "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
              }
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "result", "submission", "archive", "release"],
          "properties": {
            "schema_version": { "const": 1 },
            "controller": { "$ref": "#/$defs/controllerQualification" },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result_id", "problem_id", "statement_revision", "commit", "tree_digest"],
              "properties": {
                "result_id": { "$ref": "#/$defs/result" },
                "problem_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
                "statement_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "commit": { "$ref": "#/$defs/commit" },
                "tree_digest": { "$ref": "#/$defs/digest" }
              }
            },
            "submission": {
              "type": "object",
              "additionalProperties": false,
              "required": ["submission_id", "owner_login", "declared_model", "production_metadata"],
              "properties": {
                "submission_id": { "$ref": "#/$defs/uuid7" },
                "owner_login": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
                },
                "declared_model": { "type": "string", "minLength": 1, "maxLength": 256 },
                "production_metadata": { "$ref": "#/$defs/productionMetadata" }
              }
            },
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "archive_repository", "archive_commit", "archive_path",
                "archive_ciphertext_sha256", "encrypted"
              ],
              "properties": {
                "archive_repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "archive_commit": { "$ref": "#/$defs/commit" },
                "archive_path": {
                  "type": "string",
                  "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
                },
                "archive_ciphertext_sha256": { "$ref": "#/$defs/digest" },
                "encrypted": { "const": true }
              }
            },
            "release": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accepted_at", "eligible_at", "path", "license"],
              "properties": {
                "accepted_at": { "$ref": "#/$defs/timestamp" },
                "eligible_at": { "$ref": "#/$defs/timestamp" },
                "path": {
                  "type": "string",
                  "pattern": "^releases/[0-9]{4}/[0-9]{2}/r2_[0-9a-f]{64}$"
                },
                "license": { "const": "Apache-2.0" }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "controllerQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "environment", "mode", "release_repository", "release_commit",
        "state_repository", "state_commit", "state_contract_commit",
        "state_source_event_count", "state_source_digest", "release_queue_sha256",
        "acceptance_snapshot_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "environment": { "const": "production" },
        "mode": { "const": "publication" },
        "release_repository": { "const": "leanprover/lean-eval-releases" },
        "release_commit": { "$ref": "#/$defs/commit" },
        "state_repository": { "const": "leanprover/lean-eval-state" },
        "state_commit": { "$ref": "#/$defs/commit" },
        "state_contract_commit": { "const": "501d237d46c7b3466a37554c1c2ceb310245a619" },
        "state_source_event_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "state_source_digest": { "$ref": "#/$defs/digest" },
        "release_queue_sha256": { "$ref": "#/$defs/digest" },
        "acceptance_snapshot_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "result": { "type": "string", "pattern": "^r2_[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "metadataText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "productionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credit_identity": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 256 }]
        },
        "component_models": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 256 }]
          }
        },
        "harness": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 1024 }]
        },
        "human_involvement": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 1024 }]
        },
        "web_access": { "type": "boolean" },
        "wall_time_seconds": { "type": "number", "minimum": 0, "maximum": 31536000 },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "billing_mode": { "enum": ["api", "subscription", "unknown"] },
        "prompt": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 8192 }]
        },
        "notes": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 4096 }]
        }
      }
    }
  }
}
