{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/release-plan-v1.schema.json",
  "title": "LeanEval release preparation plan v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "empty" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "next_release_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "not_due" },
        "next_release_at": { "$ref": "release-queue-v1.schema.json#/$defs/timestamp" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "started_transition", "request"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "execution" },
        "started_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_type", "subject_id", "causation_event_id", "payload"],
          "properties": {
            "event_type": { "const": "release.started" },
            "subject_id": { "$ref": "release-queue-v1.schema.json#/$defs/result" },
            "causation_event_id": { "$ref": "release-queue-v1.schema.json#/$defs/uuid7" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt"],
              "properties": {
                "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
              }
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "result", "submission", "archive", "release"],
          "properties": {
            "schema_version": { "const": 1 },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result_id", "problem_id", "statement_revision", "commit", "tree_digest"],
              "properties": {
                "result_id": { "$ref": "release-queue-v1.schema.json#/$defs/result" },
                "problem_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
                "statement_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "commit": { "$ref": "release-queue-v1.schema.json#/$defs/commit" },
                "tree_digest": { "$ref": "release-queue-v1.schema.json#/$defs/digest" }
              }
            },
            "submission": {
              "type": "object",
              "additionalProperties": false,
              "required": ["submission_id", "owner_login", "declared_model", "production_metadata"],
              "properties": {
                "submission_id": { "$ref": "release-queue-v1.schema.json#/$defs/uuid7" },
                "owner_login": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
                },
                "declared_model": { "type": "string", "minLength": 1, "maxLength": 256 },
                "production_metadata": { "$ref": "release-queue-v1.schema.json#/$defs/productionMetadata" }
              }
            },
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "archive_repository", "archive_commit", "archive_path",
                "archive_ciphertext_sha256", "encrypted"
              ],
              "properties": {
                "archive_repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "archive_commit": { "$ref": "release-queue-v1.schema.json#/$defs/commit" },
                "archive_path": {
                  "type": "string",
                  "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
                },
                "archive_ciphertext_sha256": { "$ref": "release-queue-v1.schema.json#/$defs/digest" },
                "encrypted": { "const": true }
              }
            },
            "release": {
              "type": "object",
              "additionalProperties": false,
              "required": ["eligible_at", "path", "license"],
              "properties": {
                "eligible_at": { "$ref": "release-queue-v1.schema.json#/$defs/timestamp" },
                "path": {
                  "type": "string",
                  "pattern": "^releases/[0-9]{4}/[0-9]{2}/r2_[0-9a-f]{64}$"
                },
                "license": { "const": "Apache-2.0" }
              }
            }
          }
        }
      }
    }
  ]
}
