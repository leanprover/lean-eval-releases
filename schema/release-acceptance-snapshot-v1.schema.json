{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/release-acceptance-snapshot-v1.schema.json",
  "title": "LeanEval release acceptance snapshot schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "submissions"],
  "properties": {
    "schema_version": { "const": 1 },
    "submissions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted_at",
          "archive_repository",
          "archive_commit",
          "archive_path",
          "archive_ciphertext_sha256"
        ],
        "properties": {
          "accepted_at": {
            "type": "string",
            "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "archive_ciphertext_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archive_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "archive_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "archive_path": {
            "type": "string",
            "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
          }
        }
      }
    }
  }
}
