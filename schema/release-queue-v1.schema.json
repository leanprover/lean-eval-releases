{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/release-queue-v1.schema.json",
  "title": "LeanEval release queue schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "source_event_count", "source_digest", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["production", "staging"] },
    "source_event_count": { "type": "integer", "minimum": 1 },
    "source_digest": { "$ref": "#/$defs/digest" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "result": { "type": "string", "pattern": "^r2_[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "metadataText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "productionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credit_identity": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 256 }]
        },
        "component_models": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 256 }]
          }
        },
        "harness": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 1024 }]
        },
        "human_involvement": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 1024 }]
        },
        "web_access": { "type": "boolean" },
        "wall_time_seconds": { "type": "number", "minimum": 0, "maximum": 31536000 },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "billing_mode": { "enum": ["api", "subscription", "unknown"] },
        "prompt": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 8192 }]
        },
        "notes": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 4096 }]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id", "submission_id", "owner_login", "declared_model",
        "problem_id", "statement_revision", "result_commit", "result_tree_digest",
        "accepted_at", "release_at", "archive_repository", "archive_commit",
        "archive_path", "archive_ciphertext_sha256", "publication_choice",
        "production_metadata", "status", "attempt", "event_id", "occurred_at"
      ],
      "properties": {
        "result_id": { "$ref": "#/$defs/result" },
        "submission_id": { "$ref": "#/$defs/uuid7" },
        "owner_login": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
        },
        "declared_model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "problem_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
        "statement_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "result_commit": { "$ref": "#/$defs/commit" },
        "result_tree_digest": { "$ref": "#/$defs/digest" },
        "accepted_at": { "$ref": "#/$defs/timestamp" },
        "release_at": { "$ref": "#/$defs/timestamp" },
        "archive_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "archive_commit": { "$ref": "#/$defs/commit" },
        "archive_path": {
          "type": "string",
          "pattern": "^archives/[0-9a-f]{2}/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.tar\\.age$"
        },
        "archive_ciphertext_sha256": { "$ref": "#/$defs/digest" },
        "publication_choice": { "const": "scheduled" },
        "production_metadata": { "$ref": "#/$defs/productionMetadata" },
        "status": { "enum": ["scheduled", "failed"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "event_id": { "$ref": "#/$defs/uuid7" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "retryable": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "scheduled" } }, "required": ["status"] },
          "then": {
            "not": { "anyOf": [{ "required": ["reason_code"] }, { "required": ["retryable"] }] }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "required": ["reason_code", "retryable"],
            "properties": {
              "attempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "retryable": { "const": true }
            }
          }
        }
      ]
    }
  }
}
